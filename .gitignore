# Cargo build artifacts
/target/

# rustfmt backup files
**/*.rs.bk

# MSVC debug symbols (harmless to ignore on other platforms)
*.pdb

# Cargo.lock is intentionally NOT ignored: this is a binary crate, so the
# lockfile is committed to pin dependency versions for reproducible builds.

# Proc-macro expansion output from cargo-expand
expanded.rs

# Coverage output (grcov / cargo-llvm-cov / tarpaulin)
*.profraw
*.profdata
/coverage/
lcov.info
cobertura.xml
tarpaulin-report.html
